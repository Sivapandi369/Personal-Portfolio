# ---- Server ----
PORT=3000
HOST=0.0.0.0

# ---- Storage ----
# Leave both empty for local development (uses ./data and ./public/uploads).
# On hosts with an EPHEMERAL filesystem (Render, Heroku, Fly...) point these at
# a mounted persistent disk, otherwise every deploy/restart wipes your content.
#   e.g. on Render with a disk mounted at /var/data:
#     DATA_DIR=/var/data/db
#     UPLOAD_DIR=/var/data/uploads
DATA_DIR=
UPLOAD_DIR=

# ---- Admin account (used only on the FIRST run, when data/db.json is created) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=sivapandi622004@gmail.com

# ---- Sessions ----
# Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# ---- Optional: forward contact-form messages to your inbox ----
# Leave blank to only store them in the admin panel inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
